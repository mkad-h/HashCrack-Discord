# Discord
DISCORD_TOKEN=TOKEN_DISCORD
ALLOWED_USER_IDS=USER_ID_DISCORD,OTRO_USER_ID   # IDs de Discord separados por coma (solo estos pueden usar el bot)
# Opcional: ALLOWED_ROLE_IDS=...

# Vast.ai
VAST_API_KEY=API_KEY_VAST_NO_ESTA_LA_MIA_PILLIN

# Configuración de cracking | Config Low Cost, alrededor de 0.312 por hora (Se puede modificar)
DEFAULT_GPU_QUERY=gpu_name=RTX_4090 num_gpus=1 verified=true rentable=true disk_space>=40
MAX_CONCURRENT_JOBS=1
MAX_JOB_MINUTES=90
POLL_INTERVAL_SECONDS=30

# Rockyou definida por default (pero se pueden agregar más)
